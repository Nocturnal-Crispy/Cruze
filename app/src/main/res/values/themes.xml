<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark by default: the launch window must already be black or the app flashes white. -->
    <style name="Theme.Cruze" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cruze_black</item>
        <item name="android:statusBarColor">@color/cruze_black</item>
        <item name="android:navigationBarColor">@color/cruze_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
